# Default Compose mode runs against the synthetic PostgreSQL database.
ANALYTICS_MODE=demo
ANALYTICS_API_PORT=8072
ANALYTICS_UI_PORT=8572

# Optional for the LLM mode. Use a private .env or process environment.
ANALYTICS_LLM_MODEL=gpt-4.1-mini
ANALYTICS_LLM_BASE_URL=
ANALYTICS_LLM_OUTPUT=tool
ANALYTICS_LLM_TIMEOUT_SECONDS=25
OPENAI_API_KEY=
ANALYTICS_INPUT_USD_PER_MILLION=
ANALYTICS_OUTPUT_USD_PER_MILLION=

# Optional metrics-only tracing.
ANALYTICS_LANGSMITH=false
LANGSMITH_PROJECT=enterprise-agentic-analytics
LANGSMITH_API_KEY=
